@{
}
@using Microsoft.AspNetCore.Http;
@{
    var rol = Context.Session.GetString("rol") ?? "No Role";
    var usuario = Context.Session.GetString("usuario") ?? "No User";
    var nombre = Context.Session.GetString("nombre") ?? "No Name";
}
<style>
    body {
        background: linear-gradient(to bottom, #f4f7fb, #ffffff);
        font-family: Arial, Helvetica, sans-serif;
    }

    .titulo {
        text-align: center;
        margin-top: 40px;
    }

        .titulo h1 {
            font-size: 70px;
            font-weight: bold;
            color: #081c45;
        }

        .titulo p {
            font-size: 28px;
            color: #555;
        }

    .contenedor-modulos {
        display: flex;
        justify-content: center;
        gap: 25px;
        flex-wrap: wrap;
        margin-top: 50px;
        padding-bottom: 50px;
    }

    .modulo-card {
        width: 220px;
        height: 320px;
        background: linear-gradient(180deg, #CC27F5,#3A0344 );
        border-radius: 25px;
        text-align: center;
        padding: 20px;
        color: white;
        transition: 0.3s;
        box-shadow: 0px 10px 20px rgba(0,0,0,0.15);
        text-decoration: none;
    }

        .modulo-card:hover {
            transform: translateY(-10px);
            box-shadow: 0px 15px 25px rgba(0,0,0,0.25);
        }

        .modulo-card img {
            width: 110px;
            height: 110px;
            margin-top: 10px;
            margin-bottom: 15px;
        }

        .modulo-card h3 {
            font-size: 34px;
            margin-bottom: 15px;
            font-weight: bold;
        }

        .modulo-card p {
            font-size: 20px;
            line-height: 1.4;
        }

    .imagen-tienda {
        position: absolute;
        left: 50px;
        top: 180px;
        width: 320px;
    }

</style>

<div class="contenedor-modulos">


    <a class="modulo-card" href="@Url.Action("CrearCliente", "Clientes")">
        <img src="https://cdn-icons-png.flaticon.com/512/686/686348.png" />
        <h3>Nuevo</h3>
        <p>Agregar Cliente a sistema</p>
    </a>

    <a class="modulo-card" href="@Url.Action("ListadoClientes", "Clientes")">
        <img src="https://cdn-icons-png.flaticon.com/512/2808/2808392.png" />
        <h3>Cambio</h3>
        <p>Cambiar un Cliente ya existente</p>
    </a>






