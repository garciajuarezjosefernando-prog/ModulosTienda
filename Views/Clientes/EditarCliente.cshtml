@model Cliente

<button type="button" class="btn btn-secondary" style=" background:
                linear-gradient(
                180deg,
                #CC27F5,
                #3A0344
                );
                border:none;"
        onclick="confirmarSalida('@Url.Action("Clientes", "Clientes")')">
    ⬅ Regresar
</button>


<form asp-controller="Clientes" asp-action="ListadoEditarCliente" method="post">
    
    <div class="card shadow">

        <div class="card-header text-white"
             style="
                background:
                linear-gradient(
                    180deg,
                    #CC27F5,
                    #3A0344
                );
             ">

            <div class="d-flex justify-content-between">

                <h3>EDITAR CLIENTE</h3>



            </div>

        </div>
    </div>

    <table class="table">

        <input type="hidden" asp-for="idCliente" />

       
        <tr>
            <td><label>Nombre</label></td>
            <td><input asp-for="nombre" class="form-control" required /></td>
        </tr>

        <tr>
            <td><label>RFC</label></td>
            <td>
                <!-- 🔒 No editable -->
                <input asp-for="RFC" class="form-control" readonly />
            </td>
        </tr>

        <tr>
            <td><label>Tipo Cliente</label></td>
            <td>
                <select asp-for="tipoCliente" class="form-control">
                    <option value="NORMAL">Normal</option>
                    <option value="VIP">VIP</option>
                </select>
            </td>
        </tr>

        <tr>
            <td><label>Teléfono</label></td>
            <td><input asp-for="telefono" class="form-control" required /></td>
        </tr>

        <tr>
            <td><label>Email</label></td>
            <td><input asp-for="email" class="form-control" required /></td>
        </tr>

        <tr>
            <td><label>Dirección</label></td>
            <td><input asp-for="direccion" class="form-control" required /></td>
        </tr>

        <tr>
            <td><label>Ciudad</label></td>
            <td><input asp-for="ciudad" class="form-control" required /></td>
        </tr>

        <tr>
            <td><label>Estado</label></td>
            <td><input asp-for="estado" class="form-control" required /></td>
        </tr>

        <tr>
            <td><label>CP</label></td>
            <td><input asp-for="cp" class="form-control" required /></td>
        </tr>

        <tr>
            <td><label>País</label></td>
            <td><input asp-for="pais" class="form-control" required /></td>
        </tr>

        <tr>
            <td><label>Activo</label></td>
            <td>
                <input asp-for="activo" type="checkbox" />
            </td>
        </tr>

        <tr>
            <td colspan="2">
                <button type="submit" class="btn btn-success">
                    Guardar Cambios
                </button>
            </td>
        </tr>

    </table>
</form>

@if (TempData["Mensaje"] != null)
{
    <script>
        alert("@TempData["Mensaje"]");
        window.location.href = '@Url.Action("ListadoClientes", "Clientes")';
    </script>
}

<script>
    let formularioModificado = false;

    // Detectar cambios en cualquier input del formulario
    document.querySelectorAll("input").forEach(input => {
        input.addEventListener("change", () => {
            formularioModificado = true;
        });
    });

    function confirmarSalida(url) {
        if (formularioModificado) {
            let confirmar = confirm("⚠️ Tienes cambios sin guardar. ¿Seguro que deseas salir?");
            if (confirmar) {
                window.location.href = url;
            }
        } else {
            window.location.href = url;
        }
    }
</script>