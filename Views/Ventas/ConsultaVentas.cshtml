@{
    ViewData["Title"] = "Consulta Ventas";
}

<div class="container-fluid mt-3">

    <div class="card shadow">

        <div class="card-header text-white"
             style="
                background:
                linear-gradient(
                    180deg,
                    #CC27F5,
                    #3A0344
                );
             ">

            <div class="d-flex justify-content-between">

                <h3>NOTAS DE VENTA</h3>

                <h4>
                    @Context.Session.GetString("nombre")
                </h4>

            </div>

        </div>

        <div class="card-body">

            <div class="mb-3">

                <a href="/Ventas/Ventas"
                   class="btn text-white"
                style="
                background:
                linear-gradient(
                180deg,
                #CC27F5,
                #3A0344
                );
                border:none;
                ">

                    Nueva Nota

                </a>

                <a href="/Ventas/BuscarClientes"
                   class="btn text-white"
                style="
                background:
                linear-gradient(
                180deg,
                #CC27F5,
                #3A0344
                );
                border:none;
                ">

                    Buscar

                </a>

            </div>

            <table class="table table-bordered">

                <thead
                    style="
                        background:#10B5F5;
                        color:white;
                    ">

                    <tr>

                        <th>Folio Nota</th>
                        <th>Cliente</th>
                        <th>Importe</th>
                        <th>Estado</th>
                        <th width="120"></th>

                    </tr>

                </thead>

                <tbody id="tablaVentas">

                </tbody>

            </table>

        </div>

    </div>

</div>

<script>

window.onload = function ()
{
    let ventasGuardadas =
        localStorage.getItem(
            "ventasFiltradas"
        );

    if(ventasGuardadas)
    {
        let data =
            JSON.parse(
                ventasGuardadas
            );

        mostrarVentas(data);

        localStorage.removeItem(
            "ventasFiltradas"
        );

        return;
    }

    cargarVentas();
};


function cargarVentas(folio = "", cliente = "", estado = "", desde = "", hasta = "")
{
    fetch('/Ventas/ObtenerVentas?' + 'folio=' + folio + '&cliente=' + cliente + '&estado=' + estado + '&desde=' + desde + '&hasta=' + hasta)

    .then(response => response.json())

    .then(data => {

    mostrarVentas(data);

        data.forEach(v => {

            let estadoTexto = "";
            let colorEstado = "";

            if(v.estado == "AC")
            {
                estadoTexto = "Abierta";
                colorEstado = "green";
            }

            if(v.estado == "PA")
            {
                estadoTexto = "Pagada";
                colorEstado = "blue";
            }

            if(v.estado == "CA")
            {
                estadoTexto = "Cancelada";
                colorEstado = "red";
            }

            let puedeEliminar =
                v.puedeEliminar;

            html += `
                <tr>

                    <td>${v.folio}</td>

                    <td>${v.cliente}</td>

                    <td>
                        $${v.importe}
                    </td>

                    <td
                        style="
                            color:${colorEstado};
                            font-weight:bold;
                        ">
                        ${estadoTexto}
                    </td>

                    <td>

                        <button
                            class="btn btn-dark btn-sm"
                            onclick="editar(${v.folio})">

                            ✏️

                        </button>

                        <button
                            class="btn btn-danger btn-sm"
                            onclick="eliminar(${v.folio})"

                            ${!puedeEliminar
                                ? "disabled"
                                : ""
                            }>

                            ❌

                        </button>

                    </td>

                </tr>
            `;
        });

        document.getElementById(
            "tablaVentas"
        ).innerHTML = html;

    });
}
function mostrarVentas(data)
{
    let html = "";

    data.forEach(v => {

        let estadoTexto = "";
        let colorEstado = "";

        if(v.estado == "AC")
        {
            estadoTexto = "Abierta";
            colorEstado = "green";
        }

        if(v.estado == "PA")
        {
            estadoTexto = "Pagada";
            colorEstado = "blue";
        }

        if(v.estado == "CA")
        {
            estadoTexto = "Cancelada";
            colorEstado = "red";
        }

        let puedeEliminar =
            v.puedeEliminar;

        html += `
            <tr>

                <td>${v.folio}</td>

                <td>${v.cliente}</td>

                <td>
                    $${v.importe}
                </td>

                <td
                    style="
                        color:${colorEstado};
                        font-weight:bold;
                    ">
                    ${estadoTexto}
                </td>

                <td>

                    <button
                        class="btn btn-dark btn-sm"
                        onclick="editar(${v.folio})">

                        ✏️

                    </button>

                    <button
                        class="btn btn-danger btn-sm"
                        onclick="eliminar(${v.folio})"

                        ${!puedeEliminar
                            ? "disabled"
                            : ""
                        }>

                        ❌

                    </button>

                </td>

            </tr>
        `;
    });

    document.getElementById(
        "tablaVentas"
    ).innerHTML = html;
}

function editar(idVenta)
{
    window.location.href =
        "/Ventas/Ventas?idVenta=" +
        idVenta;
}

function eliminar(idVenta)
{
    if(!confirm("¿Eliminar nota?"))
    {
        return;
    }

    fetch(
        '/Ventas/EliminarVenta?idVenta=' + idVenta,
        {
            method:'POST'
        }
    )

    .then(response => response.json())

    .then(data => {

        if(data.ok)
        {
            alert(
                "Nota eliminada"
            );

            cargarVentas();
        }
        else
        {
            alert(data.mensaje);
        }

    });
}

</script>