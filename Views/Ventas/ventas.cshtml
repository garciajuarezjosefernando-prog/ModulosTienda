@{
    ViewData["Title"] = "Ventas";
}


<input type="text"
       id="buscar"
       class="form-control"
       placeholder="Buscar producto..." />

<br />

<table class="table">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Precio</th>
            <th></th>
        </tr>
    </thead>

    <tbody id="resultados">
    </tbody>
</table>

<hr />

<h3>Nota</h3>

<table class="table">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Precio</th>
        </tr>
    </thead>

    <tbody id="nota">
    </tbody>
</table>

<script>

document.getElementById("buscar")
.addEventListener("keyup", function(){

    let texto = this.value;

    fetch('/Ventas/BuscarProductos?texto=' + texto)
    .then(response => response.json())
    .then(data => {

        let html = "";

        data.forEach(p => {

            html += `
                <tr>
                    <td>${p.nombre}</td>
                    <td>$${p.precio}</td>

                    <td>
                        <button onclick="agregarProducto('${p.nombre}', '${p.precio}')"
                                class="btn btn-primary">

                            Agregar

                        </button>
                    </td>
                </tr>
            `;
        });

        document.getElementById("resultados").innerHTML = html;
    });

});

function agregarProducto(nombre, precio){

    let fila = `
        <tr>
            <td>${nombre}</td>
            <td>$${precio}</td>
        </tr>
    `;

    document.getElementById("nota")
            .innerHTML += fila;
}

</script>