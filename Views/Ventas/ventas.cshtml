@{
    ViewData["Title"] = "Ventas";
}

@{
    var rol = Context.Session.GetString("rol") ?? "No Role";
    //var usuario = Context.Session.GetString("usuario") ?? "No User";
    //var nombre = Context.Session.GetString("nombre") ?? "No Name";
}
<div class="container-fluid mt-3">

    <div class="card shadow">

       <div class="card-header text-white"

style="
background: linear-gradient(
180deg,
#CC27F5,
#3A0344
);
">

    <div class="d-flex
    justify-content-between
    align-items-center">

        <h2 class="mb-0 text-white">
            NOTA DE VENTA
        </h2>

        <div class="d-flex
        align-items-center
        gap-3">

            <h5 class="mb-0 text-white">

                @Context.Session.GetString(
                    "nombreCompleto"
                )

            </h5>

            <a
                id="btnRegresar"
                href="/Ventas/ConsultaVentas"
                class="btn btn-light">
                ← Regresar
            </a>

        </div>

    </div>

</div>

        <div class="card-body">

            <div class="row mb-4">

                <div class="col-md-2">

                    <label>Folio</label>

                    <input
                        type="text"
                        class="form-control"
                        id="folio"

                        value="@(
                        ViewBag.idVenta ?? 0
                        )"

                        readonly>

                </div>

                <div class="col-md-4">

                    <label>Cliente</label>

                    <input
                        type="text"
                        id="clienteBuscar"
                        class="form-control"
                        placeholder="Cliente"
                        @(ViewBag.idVenta != null
                            ? "readonly"
                            : "")
                    >

                    <div id="listaClientes"
                         class="list-group">
                    </div>

                </div>
            </div>

            <div class="mb-3">
                <input
                    type="text"
                    id="buscar"
                    class="form-control form-control-lg"
                    placeholder="Buscar producto...">
            </div>

            <table class="table">

                <thead>

                    <tr>

                        <th>Producto</th>
                        <th>Precio</th>
                        <th width="120"></th>

                    </tr>

                </thead>

                <tbody id="resultados">

                </tbody>

            </table>

            <hr>

            <table class="table table-bordered">

                <thead
                    style="
                        background:#10B5F5;
                        color:white;
                    ">

                    <tr>

                        <th>Producto</th>
                        <th>Detalle</th>
                        <th width="120">
                            Cantidad
                        </th>

                        <th width="120">
                            Precio
                        </th>

                        <th width="140">
                            Subtotal
                        </th>

                        <th width="120">Eliminar Producto</th>

                    </tr>

                </thead>

                <tbody id="nota">

                </tbody>

            </table>

            <div class="row mt-4">

                <div class="col-md-8">

                </div>

                <div class="col-md-4">

                    <div class="card">

                        <div class="card-body">

                            <h3>

                                Total Nota:

                                $<span id="total">
                                    0
                                </span>

                            </h3>

                        </div>

                    </div>

                </div>

            </div>

            <div class="mt-4 text-end">

                <button
                    class="btn btn-lg text-white"

                    style="
                    background:
                    linear-gradient(
                    180deg,
                    #CC27F5,
                    #3A0344
                    );
                    "

                    onclick="guardarNota()">

                    Guardar

                </button>

@if (rol == "AD" || rol == "MA")
{
                <button
                    class="btn btn-lg text-white ms-2"

                    style="
                    background:
                    linear-gradient(
                    180deg,
                    #CC27F5,
                    #3A0344
                    );
                    "

                    onclick="guardarNota(true)">

                    Cobrar

                </button>
}

                <button
                    class="btn btn-lg text-white ms-2"

                    style="
                    background:
                    linear-gradient(
                    180deg,
                    #CC27F5,
                    #3A0344
                    );
                    "

                    onclick="cancelarNota()">

                    Cancelar

                </button>

            </div>

        </div>

    </div>

</div>
<script>

let idVentaEditar =
    '@ViewBag.idVenta';

</script>

<script>
let productosVenta = [];
let total = 0;
let idClienteSeleccionado = 0;
let notaCerrada = false;

function cargarVenta()
{
    fetch(
        '/Ventas/ObtenerVenta?idVenta=' +
        idVentaEditar
    )

    .then(response => response.json())

    .then(data => {
        if(data.venta.estatus == "PA")
        {
            notaCerrada = true;
            bloquearPantalla();
        }
        document.getElementById(
            "clienteBuscar"
        ).value =
            data.venta.cliente;

        idClienteSeleccionado =
            data.venta.idCliente;

        productosVenta = [];

        data.detalle.forEach(p => {

            productosVenta.push({
                producto:
                    p.producto,
                cantidad:
                    Number(p.cantidad),
                detalle:
                    p.detalle,
                precio:
                    Number(p.precio) /
                    Number(p.cantidad),
                total:
                    Number(p.total)
            });
        });

        actualizarNota();
    });
}
window.onload = function ()
{
    if(idVentaEditar != "")
    {
        cargarVenta();
    }
}

function agregarProducto(nombre, precio, detalle)
{
    precio = Number(precio);

    let existe =
        productosVenta.find(
            p => p.producto == nombre
        );

    if(existe)
    {
        existe.cantidad++;

        existe.total =
            existe.cantidad *
            existe.precio;
    }
    else
    {
        productosVenta.push({

            producto: nombre,

            detalle: detalle,
        
            cantidad: 1,

            precio: precio,

           subTotal: precio,
            total: precio * 1.16
        });
    }

    actualizarNota();
}

function bloquearPantalla()
{
    document
    .querySelectorAll(
        "button,input"
    )

    .forEach(x => {

        if(
            x.id != "btnRegresar"
        )
        {
            x.disabled = true;
        }

    });
}

function guardarNota(esPago = false){

    let cliente =
        document.getElementById("clienteBuscar").value;

    if(cliente.trim() == "")
    {
        alert("Selecciona un cliente");
        return;
    }

    if(productosVenta.length == 0)
    {
        alert("Agrega al menos un producto");
        return;
    }
        let folio =
        document.getElementById(
        "folio"
        ).value;
    let subtotalSinIva =
    total / 1.16;

let iva =
    total - subtotalSinIva;

let venta = {

    idVenta: folio,

    idCliente:
        idClienteSeleccionado,
        estatus:
        esPago ? "PA" : "AC",
    subTotal:
        subtotalSinIva,

    iva:
        iva,

    cantidadTotl:
        total,

    productos:
        productosVenta
};

    fetch('/Ventas/GuardarNota', {

        method: 'POST',

        headers: {
            'Content-Type': 'application/json'
        },

        body: JSON.stringify(venta)

    })

    .then(response => response.json())

    .then(data => {

        if(data.ok)
        {
            alert("Nota guardada correctamente");
        }
        else
        {
            alert(data.mensaje);
        }

    })

    .catch(error => {

        alert(error);

    });
}
function actualizarNota()
{
    let html = "";

    total = 0;

    productosVenta.forEach((p, index) => {

        let precioConIva =
            p.precio;

        let subtotal =
            p.cantidad * precioConIva;
        total += subtotal;

        html += `
        <tr>

            <td>
                ${p.producto}
            </td>
            <td>
                ${p.detalle || ''}
            </td>
            <td>

                <input
                    type="number"
                    ${notaCerrada ? "disabled" : ""}
                    min="1"
                    value="${p.cantidad}"
                    class="form-control"
                    onchange="
                        cambiarCantidad(
                            ${index},
                            this.value
                        )
                    ">

            </td>

           <td>

                <input
                    type="number"
                    ${notaCerrada ? "disabled" : ""}
                    step="0.01"
                    min="0"
                    value="${precioConIva.toFixed(2)}"
                    class="form-control"
                    onchange="
                        cambiarPrecio(
                            ${index},
                            this.value
                        )
                    ">
            </td>

            <td>
                $${subtotal.toFixed(2)}
            </td>

            <td>

                <button
                    class="btn btn-danger btn-sm"
                    ${notaCerrada ? "disabled" : ""}
                    onclick="
                        eliminarProducto(
                            '${p.producto}'
                        )
                    ">
                    ❌
                </button>

            </td>

        </tr>
        `;
    });

    document.getElementById(
        "nota"
    ).innerHTML = html;

    document.getElementById(
        "total"
    ).innerText =
        total.toFixed(2);
}
function cambiarCantidad(index, cantidad)
{
    cantidad = Number(cantidad);

    if(cantidad <= 0)
    {
        cantidad = 1;
    }

    productosVenta[index].cantidad =
        cantidad;

    actualizarNota();
}
function cambiarPrecio(index, precio)
{
    precio = Number(precio);

    if(precio <= 0)
    {
        precio = 1;
    }

    productosVenta[index].precio =
        precio;

    actualizarNota();
}
function eliminarProducto(nombre)
{
    productosVenta =
        productosVenta.filter(
            p => p.producto != nombre
        );

    actualizarNota();
}
function cancelarNota()
{
    if(confirm("¿Cancelar nota?"))
    {
        location.reload();
    }
}
function cobrarNota(){

    alert(
        "Total a cobrar: $" +
        total.toFixed(2)
    );
}

</script>
<script>
document.getElementById("buscar")
.addEventListener("keyup", function(){

    let texto = this.value;
if(texto.trim() == ""){

    document.getElementById("resultados")
            .innerHTML = "";

    return;
}
    fetch('/Ventas/BuscarProductos?texto=' + texto)
    .then(response => response.json())
    .then(data => {

        let html = "";

        data.forEach(p => {

            html += `
                <tr>
                    <td>${p.detalle}</td>
                    
                   <td>$${(p.precio * 1.16).toFixed(2)}</td>

                    <td>
                        <button onclick="
                            agregarProducto(
                                '${p.product}',
                                '${(p.precio * 1.16).toFixed(2)}',
                                '${p.detalle ?? ""}'
                            )"
                                class="btn btn-primary">

                            Agregar

                        </button>
                    </td>
                </tr>
            `;
        });

        document.getElementById("resultados").innerHTML = html;
    });

});


</script>
<script>

document.getElementById("clienteBuscar")
.addEventListener("keyup", function(){

    let texto = this.value;

    if(texto.trim() == ""){

        document.getElementById(
            "listaClientes"
        ).innerHTML = "";

        return;
    }

   fetch('/Ventas/BuscarClientesJson?texto=' + texto)

    .then(response => response.json())

    .then(data => {

        let html = "";

        data.forEach(c => {

            html += `
                <button
                    class="list-group-item list-group-item-action"

                    onclick="seleccionarCliente(  '${c.id}', '${c.nombre}')">

                    ${c.nombre}

                </button>
            `;
        });

        document.getElementById(
            "listaClientes"
        ).innerHTML = html;
    });

});

function seleccionarCliente(id, nombre)
{
    idClienteSeleccionado = id;

    document.getElementById(
        "clienteBuscar"
    ).value = nombre;

    document.getElementById(
        "listaClientes"
    ).innerHTML = "";
}

</script>
