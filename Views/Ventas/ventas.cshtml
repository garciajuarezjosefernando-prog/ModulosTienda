@{
    ViewData["Title"] = "Ventas";
}

@{
    var rol = Context.Session.GetString("rol") ?? "No Role";
    //var usuario = Context.Session.GetString("usuario") ?? "No User";
    //var nombre = Context.Session.GetString("nombre") ?? "No Name";
}
<input type="text"
       id="buscar"
       class="form-control"
       placeholder="Buscar producto..." />

<br />

<table class="table">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Precio</th>
            <th></th>
        </tr>
    </thead>

    <tbody id="resultados">
    </tbody>
</table>

<hr />
<div class="row">

    <div class="col-md-6">
        <label>Buscar Cliente</label>

        <input type="text"
       id="clienteBuscar"
       class="form-control"
       placeholder="Buscar cliente..." />

<div id="listaClientes"
     class="list-group">
</div>


       
    </div>

</div>

<h3>Nota</h3>
<br />

<div style="
    display:flex;
    gap:10px;
    align-items:center;
">

    <strong>Cliente:</strong>

    <span id="clienteSeleccionado">
    </span>

</div>

<br />
<div style="
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:20px;
">

    <strong>Empleado:</strong>

    <span id="empleado">
        @Context.Session.GetString("nombre")
    </span>

</div>
<table class="table">

    <thead>
        <tr>
            <th>Producto</th>
            <th>Precio</th>
        </tr>
    </thead>

    <tbody id="nota">
    </tbody>

</table>

<h3>
    Total:
    $<span id="total">0</span>
</h3>

<div style="
    display:flex;
    gap:10px;
">

    <button
    type="button"
    class="btn btn-success"
    onclick="guardarNota()">
        Guardar Nota
    </button>


@if (rol == "AD" || rol == "MA"){
    <button class="btn btn-primary"
            onclick="cobrarNota()">

        Cobrar Nota

    </button>
}
</div>


<script>
let productosVenta = [];
let total = 0;

function agregarProducto(nombre, precio){

    let fila = `
        <tr>
            <td>${nombre}</td>
            <td>$${precio}</td>
        </tr>
    `;

    document.getElementById("nota")
            .innerHTML += fila;

    total += Number(precio);

    document.getElementById("total")
            .innerText = total.toFixed(2);

    productosVenta.push({

        producto: nombre,

        cantidad: 1,

        total: Number(precio)
    });
    console.log(productosVenta);
}

function guardarNota(){

    let cliente =
        document.getElementById("clienteBuscar").value;

    if(cliente.trim() == "")
    {
        alert("Selecciona un cliente");
        return;
    }

    if(productosVenta.length == 0)
    {
        alert("Agrega al menos un producto");
        return;
    }

    let venta = {

        idCliente: 1,

        subTotal: total,

        iva: total * 0.16,

        cantidadTotl: total * 1.16,

        productos: productosVenta
    };

    fetch('/Ventas/GuardarNota', {

        method: 'POST',

        headers: {
            'Content-Type': 'application/json'
        },

        body: JSON.stringify(venta)

    })

    .then(response => response.json())

    .then(data => {

        if(data.ok)
        {
            alert("Nota guardada correctamente");
        }
        else
        {
            alert(data.mensaje);
        }

    })

    .catch(error => {

        alert(error);

    });
}

function cobrarNota(){

    alert(
        "Total a cobrar: $" +
        total.toFixed(2)
    );
}

</script>
<script>
document.getElementById("buscar")
.addEventListener("keyup", function(){

    let texto = this.value;
if(texto.trim() == ""){

    document.getElementById("resultados")
            .innerHTML = "";

    return;
}
    fetch('/Ventas/BuscarProductos?texto=' + texto)
    .then(response => response.json())
    .then(data => {

        let html = "";

        data.forEach(p => {

            html += `
                <tr>
                    <td>${p.product}</td>
                    <td>$${p.precio}</td>

                    <td>
                        <button onclick="agregarProducto('${p.product}', '${p.precio}')"
                                class="btn btn-primary">

                            Agregar

                        </button>
                    </td>
                </tr>
            `;
        });

        document.getElementById("resultados").innerHTML = html;
    });

});


</script>
<script>

document.getElementById("clienteBuscar")
.addEventListener("keyup", function(){

    let texto = this.value;

    if(texto.trim() == ""){

        document.getElementById(
            "listaClientes"
        ).innerHTML = "";

        return;
    }

    fetch('/Ventas/BuscarClientes?texto=' + texto)

    .then(response => response.json())

    .then(data => {

        let html = "";

        data.forEach(c => {

            html += `
                <button
                    class="list-group-item list-group-item-action"

                    onclick="seleccionarCliente('${c.nombre}')">

                    ${c.nombre}

                </button>
            `;
        });

        document.getElementById(
            "listaClientes"
        ).innerHTML = html;
    });

});

function seleccionarCliente(nombre){

    document.getElementById(
        "clienteSeleccionado"
    ).innerText = nombre;

    document.getElementById(
        "clienteBuscar"
    ).value = nombre;

    document.getElementById(
        "listaClientes"
    ).innerHTML = "";
}

</script>
