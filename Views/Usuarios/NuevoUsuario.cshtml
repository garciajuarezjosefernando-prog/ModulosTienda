@{
}
<div class="card-form">

    <form asp-controller="Usuarios" asp-action="Guardar" method="post">


        <table class="table">
            <tr>
                <td><label>Nombre de usuario</label></td>
                <td>
                    <input type="text" name="usuario" id="usuario" maxlength="50" class="form-control" required />
                </td>
            </tr>

            <tr>
                <td><label>Nombre completo</label></td>
                <td>
                    <input type="text" name="nombre" id="nombre" maxlength="300" class="form-control" />
                </td>
            </tr>

            <tr>
                <td><label>Contraseña</label></td>
                <td>
                    <input type="password" name="contrasena" id="contrasena" maxlength="10" class="form-control" />
                </td>
            </tr>

            <tr>
                <td><label>Correo</label></td>
                <td>
                    <input type="email" name="correo" id="correo" maxlength="50" class="form-control" />
                </td>
            </tr>

            <tr>
                <td><label>Tipo</label></td>
                <td>
                    <input type="text" name="tipo" id="tipo" maxlength="2" class="form-control" />
                </td>
            </tr>

            
            <tr>
                <td>
                    <button type="submit" class="btn btn-primary">
                        Guardar Usuario
                    </button>


                    <button type="button" class="btn btn-secondary"
                        onclick="confirmarSalida('@Url.Action("Usuarios", "Usuarios")')">
                        Salir sin guardar
                    </button>

                </td>
            </tr>
        </table>

        <script>
            let formularioModificado = false;

            // Detectar cambios en cualquier input del formulario
            document.querySelectorAll("input").forEach(input => {
                input.addEventListener("change", () => {
                    formularioModificado = true;
                });
            });

            function confirmarSalida(url) {
                if (formularioModificado) {
                    let confirmar = confirm("⚠️ Tienes cambios sin guardar. ¿Seguro que deseas salir?");
                    if (confirmar) {
                        window.location.href = url;
                    }
                } else {
                    window.location.href = url;
                }
            }
        </script>

        @if (TempData["PedidoGuardado"] != null)
        {
            <script>
                window.onload = function () {
                    alert("✅ La cotización se guardó correctamente.");

                    // Redirección a pantalla principal
                    window.location.href = '@Url.Action("Index", "Home")';
                };
            </script>
        }
        <script>

            costear.addEventListener("change", () => {
              Cliente.disabled = !costear.checked;
            });



        </script>


    </form>

</div>
