@model IEnumerable<Usuario>

<div class="mb-3">
    <a href="@Url.Action("Usuarios", "Usuarios")" class="btn btn-secondary" style=" background:
                linear-gradient(
                180deg,
                #CC27F5,
                #3A0344
                );
                border:none;">
        ⬅ Regresar
    </a>
</div>


<div class="card shadow">

    <div class="card-header text-white"
         style="
                background:
                linear-gradient(
                    180deg,
                    #CC27F5,
                    #3A0344
                );
             ">

        <div class="d-flex justify-content-between">

            <h3>LISTADO DE USUARIOS</h3>



        </div>

    </div>
</div>


<form method="get" asp-action="ListadoUsuarioEditar" asp-controller"col-md-2">
            <input type="text" name="buscar" class="form-control" placeholder="Buscar por usuario o correo..." />
        
        <div class="col-md-2">
        <button type="submit" class="btn btn-primary" style=" background:
                linear-gradient(
                180deg,
                #CC27F5,
                #3A0344
                );
                border:none;">
            Buscar
        </button>
        
        </div>
    
</form>



<table class="table table-bordered table-striped">
    

    <thead>
        <tr>
            <th>Usuario</th>
            <th>Nombre</th>
            <th>Correo</th>
            <th>Tipo</th>
            <th>Activo</th>
            <th>Acción</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.usuario</td>
                <td>@item.nombre</td>
                <td>@item.correo</td>
                <td>@item.tipo</td>
                <td>
                    @(item.activo ? "Sí" : "No")
                </td>
                <td>
                    <a class="btn btn-warning btn-sm" style=" background:
                linear-gradient(
                180deg,
                #27F58E,
                #079C52
                );
                border:none;"
                       href="@Url.Action("CambioUsuario", "Usuarios", new { id = item.usuario })">
                        Editar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (TempData["ExitoCambio"] != null)
{
    <script>
        alert("@TempData["ExitoCambio"]");
    </script>
}