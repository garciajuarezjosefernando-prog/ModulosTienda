@model Usuario
<button type="button" class="btn btn-secondary"
        onclick="confirmarSalida('@Url.Action("Usuarios", "Usuarios")')">
    ⬅ Regresar
</button>
<h2>Cambiar Contraseña de Usuario</h2>

<!-- 🔍 Buscar usuario -->
<form method="get" asp-action="ContrasenaUsuario" asp-controller"col-md-4">

            <input type="text" name="usuario" class="form-control" placeholder="Ingresa el usuario" required />
        >
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    <
</form>

@if (Model != null && !string.IsNullOrEmpty(Model.usuario))
{
    <form asp-controller="Usuarios" asp-action="CambiarContrasena" method="post">
        <table class="table">
            <tr>
                <td><label>Usuario</label></td>
                <td>
                    <input asp-for="usuario" class="form-control" readonly />
                </td>
            </tr>

            <tr>
                <td><label>Nombre</label></td>
                <td>
                    <input asp-for="nombre" class="form-control" readonly />
                </td>
            </tr>

            <tr>
                <td><label>Nueva Contraseña</label></td>
                <td>
                    <input type="password" name="nuevaContrasena" class="form-control" required />
                </td>
            </tr>

            <tr>
                <td colspan="2">
                    <button type="submit" class="btn btn-success">
                        Cambiar Contraseña
                    </button>
                </td>
            </tr>

        </table>
    </form>
}
<script>
    let formularioModificado = false;

    // Detectar cambios en cualquier input del formulario
    document.querySelectorAll("input").forEach(input => {
        input.addEventListener("change", () => {
            formularioModificado = true;
        });
    });

    function confirmarSalida(url) {
        if (formularioModificado) {
            let confirmar = confirm("Tienes cambios sin guardar. ¿Seguro que deseas salir?");
            if (confirmar) {
                window.location.href = url;
            }
        } else {
            window.location.href = url;
        }
    }
</script>
@if (TempData["Mensaje"] != null)
{
    <script>
        alert("@TempData["Mensaje"]");
    </script>
}