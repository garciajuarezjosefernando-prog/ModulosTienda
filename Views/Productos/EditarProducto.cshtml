@model ProductoSTRUC

<div class="mb-3">
    <a href="@Url.Action("ListadoProductoEditar", "Productos")" class="btn btn-secondary" style=" background:
                linear-gradient(
                180deg,
                #CC27F5,
                #3A0344
                );
                border:none;">
        ⬅ Regresar
    </a>
</div>

<div class="card shadow">

    <div class="card-header text-white"
         style="
                background:
                linear-gradient(
                    180deg,
                    #CC27F5,
                    #3A0344
                );
             ">

        <div class="d-flex justify-content-between">

            <h3>EDITAR PRODUCTO</h3>



        </div>

    </div>
</div>
<form asp-controller="Productos" asp-action="EditarProducto" method="post">
    <!-- 🔒 Se envía pero no se puede modificar -->
    <input type="hidden" asp-for="producto" />

    <table class="table">

        <tr>
            <td><label>Producto</label></td>
            <td>
                <!-- Visible pero bloqueado -->
                <input asp-for="producto" class="form-control" readonly />
            </td>
        </tr>

        <tr>
            <td><label>Descripción</label></td>
            <td>
                <input asp-for="descripcion" class="form-control" required />
            </td>
        </tr>

        <tr>
            <td><label>UM</label></td>
            <td>
                <select asp-for="UM" class="form-control" required>
                    <option value="KG">KG - Kilogramos</option>
                    <option value="PZ">PZ - Pieza</option>
                    <option value="LT">LT - Litros</option>
                    <option value="BT">BT - Botella</option>
                </select>
            </td>
        </tr>

        <tr>
            <td><label>Precio</label></td>
            <td>
                <input asp-for="precio" type="number" step="0.001" class="form-control" required />
            </td>
        </tr>

        <tr>
            <td><label>Máximo almacén</label></td>
            <td>
                <input asp-for="maximoAlm" type="number" class="form-control" required />
            </td>
        </tr>

        <tr>
            <td><label>Mínimo almacén</label></td>
            <td>
                <input asp-for="minimoAlm" type="number" class="form-control" required />
            </td>
        </tr>

        <tr>
            <td><label>% Comisión</label></td>
            <td>
                <input asp-for="porComision" type="number" min="0" max="100" step="0.01" class="form-control" required />
            </td>
        </tr>

        <tr>
            <td><label>Activo</label></td>
            <td>
                <input asp-for="activo" type="checkbox" />
            </td>
        </tr>

        <tr>
            <td><label>Costo</label></td>
            <td>
                <input asp-for="costo" type="number" step="0.001" class="form-control" required />
            </td>
        </tr>


        <tr>
            <td colspan="2">
                <button type="submit" class="btn btn-success">
                    Guardar Cambios
                </button>
            </td>
        </tr>

    </table>
</form>

@if (TempData["Mensaje"] != null)
{
    <script>
        alert("@TempData["Mensaje"]");
        window.location.href = '@Url.Action("Productos", "Productos")';
    </script>
}

<script>
    let formularioModificado = false;

    // Detectar cambios en cualquier input del formulario
    document.querySelectorAll("input").forEach(input => {
        input.addEventListener("change", () => {
            formularioModificado = true;
        });
    });

    function confirmarSalida(url) {
        if (formularioModificado) {
            let confirmar = confirm("⚠️ Tienes cambios sin guardar. ¿Seguro que deseas salir?");
            if (confirmar) {
                window.location.href = url;
            }
        } else {
            window.location.href = url;
        }
    }
</script>