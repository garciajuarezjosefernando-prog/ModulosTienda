@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <title>Login</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <style>

        body{
            margin:0;
            font-family:Arial;
            background:#f5f5f7;
        }

        .login-container{
            display:flex;
            height:100vh;
        }

        .login-left{
            width:50%;

            display:flex;
            flex-direction:column;

            justify-content:center;
            align-items:center;

            background:
            linear-gradient(
            135deg,
            #f7f7f7,
            #ece9f7
            );
        }

        .login-left img{
            width:350px;
        }

        .login-left h2{
            margin-top:20px;
            font-size:40px;
            letter-spacing:8px;
        }

        .login-left p{
            font-size:22px;
            color:#555;
        }

        .login-right{
            width:50%;

            display:flex;

            justify-content:center;
            align-items:center;
        }

        .login-card{

            width:450px;

            background:white;

            padding:40px;

            border-radius:20px;

            box-shadow:
            0 10px 30px
            rgba(0,0,0,.15);
        }

        .btn-login{

            width:100%;

            background:
            linear-gradient(
            180deg,
            #CC27F5,
            #3A0344
            );

            border:none;

            color:white;

            height:50px;

            font-size:20px;

            border-radius:10px;
        }

        .btn-login:hover{
            opacity:.9;
        }

    </style>

</head>

<body>

<div class="login-container">

    <div class="login-left">

        <img src="/img/logo.jpeg">

        <h2>BREN HOUSE</h2>

        <p>
            Sistema de gestión para tu negocio
        </p>

    </div>

    <div class="login-right">

        <div class="login-card">

            <h1 class="mb-4 text-center">
                Iniciar Sesión
            </h1>

            <form
                asp-controller="Account"
                asp-action="Login"
                method="post">

                <div class="mb-3">

                    <input
                        type="text"
                        name="usuario"
                        class="form-control form-control-lg"
                        placeholder="Usuario">

                </div>

                <div class="mb-4">

                    <input
                        type="password"
                        name="password"
                        class="form-control form-control-lg"
                        placeholder="Contraseña">

                </div>

                <button
                    type="submit"
                    class="btn-login">

                    Entrar

                </button>

            </form>

        </div>

    </div>

</div>

</body>

</html>