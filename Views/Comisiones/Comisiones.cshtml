@{
    ViewData["Title"] = "Comisiones";
}

<div class="container-fluid mt-3">

    <div class="card shadow">

        <div class="card-header text-white"

        style="
        background:
        linear-gradient(
        180deg,
        #CC27F5,
        #3A0344
        );
        ">

            <div class="d-flex
            justify-content-between
            align-items-center">

                <h3>
                    COMISIONES
                </h3>

                <a
                    href="/Home/Index"

                    class="btn btn-light">

                    ← Regresar

                </a>

            </div>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-3">

                    <label>
                        Usuario
                    </label>

                    <input
                        type="text"
                        id="usuario"
                        class="form-control">

                </div>

                <div class="col-md-3">

                    <label>
                        Fecha Desde
                    </label>

                    <input
                        type="date"
                        id="desde"
                        class="form-control">

                </div>

                <div class="col-md-3">

                    <label>
                        Fecha Hasta
                    </label>

                    <input
                        type="date"
                        id="hasta"
                        class="form-control">

                </div>

                <div class="col-md-3 d-flex align-items-end">

                    <button

                        class="btn text-white w-100"

                        style="
                        background:
                        linear-gradient(
                        180deg,
                        #CC27F5,
                        #3A0344
                        );
                        border:none;
                        "

                        onclick="buscar()">

                        Buscar

                    </button>

                </div>

            </div>

            <hr>

            <table class="table table-bordered">

                <thead
                style="
                background:#10B5F5;
                color:white;
                ">

                    <tr>

                        <th>Producto</th>
                        <th>Descripción</th>
                        <th>Cantidad</th>
                        <th>Total Venta</th>
                        <th>Fecha Venta</th>
                        <th>% Comisión</th>
                        <th>$ Comisión</th>
                        <th>Status</th>

                    </tr>

                </thead>

                <tbody id="tablaComisiones">

                </tbody>

            </table>

            <div class="row mt-4">

                <div class="col-md-8"></div>

                <div class="col-md-4">

                    <div class="card">

                        <div class="card-body">

                            <h3>

                                Total Comisión:

                                $<span id="total">
                                    0
                                </span>

                            </h3>

                        </div>

                    </div>

                </div>

            </div>

            <div class="mt-3 text-end">

                <button
                    onclick="pagarComisiones()"
                    class="btn text-white"

                    style="
                    background:
                    linear-gradient(
                    180deg,
                    #CC27F5,
                    #3A0344
                    );
                    border:none;
                    ">

                    Pagar Comisiones

                </button>

            </div>

        </div>

    </div>

</div>
<script>

function buscar()
{
    let usuario =
        document.getElementById(
            "usuario"
        ).value;

    let desde =
        document.getElementById(
            "desde"
        ).value;

    let hasta =
        document.getElementById(
            "hasta"
        ).value;

    if(usuario.trim() == "")
    {
        alert(
            "Selecciona usuario"
        );

        return;
    }

    if(
        desde == "" &&
        hasta == ""
    )
    {
        alert(
            "Selecciona fecha"
        );

        return;
    }

    fetch(

        '/Comisiones/Buscar?' +

        'usuario=' + usuario +

        '&desde=' + desde +

        '&hasta=' + hasta

    )

    .then(response => response.json())

    .then(data => {

        let html = "";

        let total = 0;

        data.forEach(x => {

            let color = "";
            let texto = "";

            if(x.status == "PE")
            {
                color = "red";
                texto = "Pendiente";

                total +=
                    Number(x.comision);
            }
            else
            {
                color = "green";
                texto = "Pagado";
            }

            html += `
            <tr>

                <td>
                    ${x.producto}
                </td>

                <td>
                    ${x.descripcion}
                </td>

                <td>
                    ${x.cantidad}
                </td>

                <td>
                    $${Number(
                        x.totalVenta
                    ).toFixed(2)}
                </td>

                <td>
                    ${x.fechaVenta}
                </td>

                <td>
                    ${x.porcentaje}%
                </td>

                <td>
                    $${Number(
                        x.comision
                    ).toFixed(2)}
                </td>

                <td
                style="
                color:${color};
                font-weight:bold;
                ">
                    ${texto}
                </td>

            </tr>
            `;
        });

        document.getElementById(
            "tablaComisiones"
        ).innerHTML = html;

        document.getElementById(
            "total"
        ).innerText =
            total.toFixed(2);

    });

}
function pagarComisiones()
{
    let usuario =
        document.getElementById(
            "usuario"
        ).value;

    let desde =
        document.getElementById(
            "desde"
        ).value;

    let hasta =
        document.getElementById(
            "hasta"
        ).value;

    if(
        !confirm(
            "¿Pagar comisiones?"
        )
    )
    {
        return;
    }

    fetch(

        '/Comisiones/PagarComisiones?' +

        'usuario=' + usuario +

        '&desde=' + desde +

        '&hasta=' + hasta,

        {
            method:'POST'
        }

    )

    .then(response => response.json())

    .then(data => {

        if(data.ok)
        {
            alert(
                "Comisiones pagadas"
            );

            buscar();
        }

    });
}

</script>